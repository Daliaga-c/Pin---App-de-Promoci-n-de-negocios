@{
    ViewData["Title"] = "Explorar Negocios";
}

<div class="max-w-7xl mx-auto py-8 px-4 flex gap-8">
    
    <aside class="w-1/4 hidden lg:block bg-white p-6 rounded-xl shadow-sm h-fit">
        <h2 class="text-xl font-bold text-gray-800 mb-6">Filtros</h2>

        <form method="get" action="@Url.Action("Index", "Negocios")">
            <div class="mb-6">
                <label class="text-xs font-bold text-gray-400 uppercase">Búsqueda Directa</label>
                <input type="text" name="search" placeholder="Ej. Cevichería..." class="w-full mt-2 p-2 bg-gray-50 border rounded-lg outline-none">
            </div>

            <div class="mb-6">
                <label class="text-xs font-bold text-gray-400 uppercase">Categorías</label>
                <div class="mt-3 space-y-2 text-gray-700">
                    <label class="flex items-center gap-2"><input type="checkbox" name="cat" value="rest" checked class="accent-orange-700"> Restaurantes</label>
                    <label class="flex items-center gap-2"><input type="checkbox" name="cat" value="tienda"> Tiendas</label>
                    <label class="flex items-center gap-2"><input type="checkbox" name="cat" value="serv"> Servicios</label>
                </div>
            </div>

            <button type="submit" class="w-full bg-orange-700 text-white py-2 rounded-lg font-bold">Aplicar Filtros</button>
        </form>
    </aside>

    <section class="flex-1">
        <div class="flex justify-between items-center mb-6">
            <p class="text-gray-600">Mostrando <span class="text-red-700 font-bold">12 negocios</span> en Miraflores</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100">
                <div class="relative h-48 bg-gray-200">
                    <img src="~/images/picanteria.jpg" alt="Local" class="w-full h-full object-cover">
                    <span class="absolute top-3 left-3 bg-orange-100 text-orange-800 text-[10px] font-bold px-2 py-1 rounded uppercase">Destacado</span>
                </div>
                
                <div class="p-5">
                    <div class="flex justify-between items-start">
                        <div>
                            <span class="text-blue-500 text-[10px] font-bold uppercase">Restaurantes</span>
                            <h3 class="font-bold text-lg text-gray-800 mt-1">La Picantería del Sur</h3>
                        </div>
                        <div class="flex items-center gap-1 bg-orange-50 px-2 py-1 rounded text-orange-700 font-bold text-sm">
                            <i class="fa-solid fa-star"></i> 4.8
                        </div>
                    </div>
                    
                    <p class="text-gray-500 text-sm mt-2">
                        <i class="fa-solid fa-location-dot mr-1"></i> Av. Larco 1230, Miraflores
                    </p>
                    <p class="text-green-600 text-xs font-semibold mt-1">Abierto</p>

                    <div class="mt-6 flex gap-3">
                        <a href="@Url.Action("Detalles", "Negocios", new { id = 1 })" class="flex-1 bg-[#A13D2D] text-white py-2 rounded-lg font-bold text-center">Ver perfil</a>
                        <button class="flex-1 bg-gray-100 text-blue-900 py-2 rounded-lg font-bold">Ruta</button>
                    </div>
                </div>
            </div>

        </div>
    </section>
</div>
