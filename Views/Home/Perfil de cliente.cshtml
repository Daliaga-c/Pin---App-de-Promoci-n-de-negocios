@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="bg-gray-50 min-h-screen pb-12">
    <div class="max-w-6xl mx-auto pt-8 px-4">
        <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-100 flex flex-col md:flex-row items-center gap-8 relative">
            <div class="relative">
                <img src="https://ui-avatars.com/api/?name=Juan+Perez&background=random&size=128" 
                     class="w-32 h-32 rounded-2xl object-cover shadow-md" alt="Foto de perfil">
                <div class="absolute -bottom-2 -right-2 bg-blue-600 text-white p-1 rounded-full border-4 border-white">
                    <i class="fa-solid fa-check text-[10px]"></i>
                </div>
            </div>

            <div class="text-center md:text-left flex-1">
                <h1 class="text-3xl font-extrabold text-gray-800">Juan Pérez</h1>
                <div class="flex flex-wrap justify-center md:justify-start gap-4 mt-3 text-sm text-gray-500 font-medium">
                    <span><i class="fa-solid fa-calendar-days mr-1 text-orange-600"></i> Miembro desde 2026</span>
                    <span><i class="fa-solid fa-location-dot mr-1 text-orange-600"></i> Lima, Perú</span>
                    <span><i class="fa-solid fa-star mr-1 text-orange-600"></i> 12 Reseñas</span>
                </div>
            </div>

            <button class="absolute top-8 right-8 bg-gray-100 p-2.5 rounded-full hover:bg-gray-200 transition-colors">
                <i class="fa-solid fa-pen text-gray-600"></i>
            </button>
        </div>
    </div>

    <div class="max-w-6xl mx-auto mt-8 px-4">
        <div class="flex gap-2 bg-gray-200/50 p-1 rounded-xl w-fit">
            <button class="bg-[#A13D2D] text-white px-6 py-2 rounded-lg font-bold shadow-sm">Mis Favoritos</button>
            <button class="text-gray-600 px-6 py-2 rounded-lg font-bold hover:bg-gray-100 transition-all">Mis Reseñas</button>
            <button class="text-gray-600 px-6 py-2 rounded-lg font-bold hover:bg-gray-100 transition-all">Ajustes</button>
        </div>
    </div>

    <div class="max-w-6xl mx-auto mt-10 px-4">
        <div class="flex justify-between items-center mb-8">
            <h2 class="text-2xl font-bold text-gray-800">Negocios Guardados <span class="text-gray-400 font-medium">(3)</span></h2>
            <button class="flex items-center gap-2 border border-gray-200 bg-white px-4 py-2 rounded-lg text-sm font-bold text-gray-700 hover:bg-gray-50">
                <i class="fa-solid fa-sliders"></i> Filtrar
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            
            <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all group">
                <div class="relative h-48">
                    <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?q=80&w=400" class="w-full h-full object-cover">
                    <button class="absolute top-4 right-4 bg-white/90 p-2 rounded-full text-red-600 shadow-sm">
                        <i class="fa-solid fa-heart"></i>
                    </button>
                    <span class="absolute bottom-4 left-4 bg-white px-3 py-1 rounded-lg text-[10px] font-bold uppercase tracking-widest">Gastronomía</span>
                </div>
                <div class="p-5">
                    <div class="flex justify-between items-center mb-2">
                        <h3 class="font-bold text-gray-800 text-lg">La Lucha Sanguchería</h3>
                        <span class="text-xs font-bold bg-orange-50 text-orange-700 px-2 py-1 rounded-lg">★ 4.8</span>
                    </div>
                    <p class="text-gray-500 text-xs leading-relaxed line-clamp-2">Los mejores sánguches criollos con sabor tradicional y papas huamantanga.</p>
                    <div class="mt-6 flex justify-between items-center border-t pt-4">
                        <span class="text-[11px] text-gray-400 font-bold"><i class="fa-solid fa-location-dot"></i> Miraflores, Lima</span>
                        <a href="#" class="text-[#A13D2D] text-xs font-extrabold hover:underline">Ver perfil</a>
                    </div>
                </div>
            </div>

            </div>
    </div>
</div>
